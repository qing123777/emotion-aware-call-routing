{
  "permissions": {
    "allow": [
      "Bash(python scripts/*)",
      "Bash(python -m pytest*)",
      "Bash(python -c*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(nvidia-smi*)",
      "PowerShell(python scripts/*)",
      "PowerShell(python -m pytest*)",
      "PowerShell(python -c*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "Read(//**)"
    ],
    "deny": [
      "Read(./data/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/guard_paths.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/log_ai_use.py\""
          }
        ]
      }
    ]
  }
}
